<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Meetanshi_AiProductStudio::root" title="AI Product Studio" sortOrder="50">
                    <resource id="Meetanshi_AiProductStudio::config" title="Configuration" sortOrder="10" />
                    <resource id="Meetanshi_AiProductStudio::log" title="Request Logs" sortOrder="20" />
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Meetanshi_AiProductStudio::configuration" title="Meetanshi - AI Product Studio" sortOrder="10" />
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
